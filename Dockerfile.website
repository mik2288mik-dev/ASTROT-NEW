# syntax=docker/dockerfile:1.7

FROM node:22-alpine AS deps
WORKDIR /app
RUN apk add --no-cache python3 make g++ libc6-compat \
    && ln -sf python3 /usr/bin/python
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

FROM node:22-alpine AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1 \
    MEOU_PUBLIC_SITE=1 \
    NEXT_PUBLIC_MEOU_PUBLIC_SITE=1

ARG NEXT_PUBLIC_SUPPORT_EMAIL
ARG NEXT_PUBLIC_PRIVACY_EMAIL
ARG NEXT_PUBLIC_DEVELOPER_NAME
ARG NEXT_PUBLIC_OPERATOR_ADDRESS
ARG NEXT_PUBLIC_OPERATOR_INN
ARG NEXT_PUBLIC_OPERATOR_OGRNIP
ARG NEXT_PUBLIC_LEGAL_PUBLICATION_DATE
ARG NEXT_PUBLIC_PUBLIC_BASE_URL=https://www.tvoi-goroskop.ru
ARG NEXT_PUBLIC_APP_NAME=NEBO
ARG NEXT_PUBLIC_RUSTORE_URL
ARG NEXT_PUBLIC_APP_LOG_RETENTION_DAYS
ARG NEXT_PUBLIC_BACKUP_RETENTION_DAYS
ARG NEXT_PUBLIC_SUPPORT_RETENTION_MONTHS
ARG NEXT_PUBLIC_MINIMUM_AGE
ARG NEXT_PUBLIC_LEGAL_PREVIEW=0

ENV NEXT_PUBLIC_SUPPORT_EMAIL=${NEXT_PUBLIC_SUPPORT_EMAIL} \
    NEXT_PUBLIC_PRIVACY_EMAIL=${NEXT_PUBLIC_PRIVACY_EMAIL} \
    NEXT_PUBLIC_DEVELOPER_NAME=${NEXT_PUBLIC_DEVELOPER_NAME} \
    NEXT_PUBLIC_OPERATOR_ADDRESS=${NEXT_PUBLIC_OPERATOR_ADDRESS} \
    NEXT_PUBLIC_OPERATOR_INN=${NEXT_PUBLIC_OPERATOR_INN} \
    NEXT_PUBLIC_OPERATOR_OGRNIP=${NEXT_PUBLIC_OPERATOR_OGRNIP} \
    NEXT_PUBLIC_LEGAL_PUBLICATION_DATE=${NEXT_PUBLIC_LEGAL_PUBLICATION_DATE} \
    NEXT_PUBLIC_PUBLIC_BASE_URL=${NEXT_PUBLIC_PUBLIC_BASE_URL} \
    NEXT_PUBLIC_APP_NAME=${NEXT_PUBLIC_APP_NAME} \
    NEXT_PUBLIC_RUSTORE_URL=${NEXT_PUBLIC_RUSTORE_URL} \
    NEXT_PUBLIC_APP_LOG_RETENTION_DAYS=${NEXT_PUBLIC_APP_LOG_RETENTION_DAYS} \
    NEXT_PUBLIC_BACKUP_RETENTION_DAYS=${NEXT_PUBLIC_BACKUP_RETENTION_DAYS} \
    NEXT_PUBLIC_SUPPORT_RETENTION_MONTHS=${NEXT_PUBLIC_SUPPORT_RETENTION_MONTHS} \
    NEXT_PUBLIC_MINIMUM_AGE=${NEXT_PUBLIC_MINIMUM_AGE} \
    NEXT_PUBLIC_LEGAL_PREVIEW=${NEXT_PUBLIC_LEGAL_PREVIEW}

COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    MEOU_PUBLIC_SITE=1 \
    NEXT_PUBLIC_MEOU_PUBLIC_SITE=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000

RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 --ingroup nodejs nextjs

COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

USER nextjs
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "const port=process.env.PORT||3000;require('node:http').get({host:'127.0.0.1',port,path:'/'},r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"

CMD ["node", "server.js"]
