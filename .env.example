# API Keys
# OpenAI API Key (optional, for future use)
OPENAI_API_KEY=your_openai_api_key_here

# Default OpenAI model for interpretations (horoscope, natal, deep dive, synastry, Oracle).
# Admin panel can override and store the choice in app_settings when DATABASE_URL is set.
# Example: gpt-4o-mini, gpt-4o, gpt-5.4-nano
OPENAI_INTERPRETATION_MODEL=gpt-4o-mini

# Database URL (Railway Database connection string)
# IMPORTANT: Use PUBLIC database URL, not internal (railway.internal)
# 
# How to get public DATABASE_URL:
# 1. Railway Dashboard → Database → Connect → Public Networking
# 2. Copy the connection string (should contain host like containers-us-west-xxx.railway.app)
# 3. Set it here or in Railway Variables
#
# Format: postgresql://user:password@host:port/database
# Example: postgresql://postgres:password123@containers-us-west-123.railway.app:5432/railway
#
# DO NOT use internal URL (postgres.railway.internal) unless running inside Railway network
DATABASE_URL=

# Ephemeris Path (path to ephe folder with Swiss Ephemeris files)
# Example: ./ephe or /path/to/ephe
EPHE_PATH=

# Next.js Public API URL (optional, for external API calls)
# Leave empty to use relative paths (/api)
NEXT_PUBLIC_API_URL=

# Daily forecast: set to 0 to stop client fallback to /api/astrology/daily-horoscope when content/forecast/daily fails (default: unset = legacy on)
# NEXT_PUBLIC_FORECAST_LEGACY_FALLBACK=0

# WeatherAPI.com API Key
# Get your free API key at https://www.weatherapi.com/signup.aspx
WEATHER_API=your_weatherapi_key_here

# Owner/Admin Telegram User ID
# This is YOUR Telegram user ID (get it from @userinfobot)
# User with this ID will have admin access
NEXT_PUBLIC_OWNER_ID=123456789

# Bot username without @ — deep links for referrals (?startapp=CODE) and Wallet share
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Telegram Bot Token (for Stars payments)
# Get from @BotFather. When set, real Telegram Stars invoices are used.
# When not set, sim mode uses showPopup + /api/subscriptions/activate
BOT_TOKEN=

# Webhook secret for Telegram Bot API (required when BOT_TOKEN is set)
# Set via setWebhook secret_token. Telegram sends it in X-Telegram-Bot-Api-Secret-Token header.
# https://core.telegram.org/bots/api#setwebhook
WEBHOOK_SECRET_TOKEN=

# Secret to protect /api/telegram/setup-webhook and /api/telegram/webhook-info (temporary setup routes)
# Pass via header X-Webhook-Setup-Secret or query ?secret=
WEBHOOK_SETUP_SECRET=

# Base URL for webhook (default: https://astrot-production.up.railway.app)
WEBHOOK_BASE_URL=
