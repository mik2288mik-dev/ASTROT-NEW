# Server-only OpenAI key for personal/natal/compatibility generation.
OPENAI_API_KEY=

# PostgreSQL connection string. The mobile app never contains this value.
# Use a private database endpoint inside the deployment network where possible.
# 
# How to get public DATABASE_URL:
# 1. Railway Dashboard → Database → Connect → Public Networking
# 2. Copy the connection string from your selected provider.
# 3. Set it in local development or deployment secrets.
#
# Format: postgresql://user:password@host:port/database
# Example: postgresql://user:password@db.example.ru:5432/your_horoscope
#
# Do not expose this URL in web bundles or Android builds.
DATABASE_URL=
# Optional local/admin fallback for a Railway private DATABASE_URL. The server
# always prefers DATABASE_URL inside Railway. Do not set this in Android builds.
DATABASE_PUBLIC_URL=

# Ephemeris Path (path to ephe folder with Swiss Ephemeris files)
# Example: ./ephe or /path/to/ephe
EPHE_PATH=

# Native release builds require an absolute HTTPS API URL. Web development can use relative /api routes.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_DISTRIBUTION_CHANNEL=development
NEXT_PUBLIC_UI_PREVIEW=0
# Capacitor Android uses https://localhost by default. Add only exact trusted
# native origins; never use * and never enable credentialed wildcard CORS.
NATIVE_APP_ORIGINS=https://localhost
# Opt-in only for local troubleshooting; never enable in a store build.
NEXT_PUBLIC_DEBUG_STORAGE_LOGS=0

# Public legal/store placeholders. Replace before publication; never put keystore passwords here.
NEXT_PUBLIC_APP_NAME=MEOU
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_DEVELOPER_NAME=
NEXT_PUBLIC_PUBLIC_BASE_URL=
NEXT_PUBLIC_PRIVACY_POLICY_URL=
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_ACCOUNT_DELETION_URL=
NEXT_PUBLIC_LEGAL_PUBLICATION_DATE=

# Public MEOU website. These values are public and are required by Dockerfile.website.
# Production builds fail closed when real operator details are missing.
MEOU_PUBLIC_SITE=0
NEXT_PUBLIC_MEOU_PUBLIC_SITE=0
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_OPERATOR_ADDRESS=
NEXT_PUBLIC_OPERATOR_INN=
NEXT_PUBLIC_OPERATOR_OGRNIP=
NEXT_PUBLIC_RUSTORE_URL=
NEXT_PUBLIC_DATA_LOCALIZATION_CONFIRMED=0
NEXT_PUBLIC_CROSS_BORDER_NOTIFICATIONS_CONFIRMED=0
# Required for an indexable production website. Use only confirmed provider facts.
NEXT_PUBLIC_RUSSIAN_HOSTING_PROVIDER=
NEXT_PUBLIC_RUSSIAN_DATA_LOCATION=
NEXT_PUBLIC_WEBSITE_HOSTING_PROVIDER=Railway Corp, Netherlands
NEXT_PUBLIC_TRANSACTIONAL_EMAIL_PROVIDER=
NEXT_PUBLIC_TRANSACTIONAL_EMAIL_COUNTRY=
NEXT_PUBLIC_SUPPORT_MAIL_PROVIDER=
NEXT_PUBLIC_SUPPORT_MAIL_COUNTRY=
NEXT_PUBLIC_GEOCODING_PROVIDER=
NEXT_PUBLIC_GEOCODING_COUNTRY=
NEXT_PUBLIC_APP_LOG_RETENTION_DAYS=
NEXT_PUBLIC_BACKUP_RETENTION_DAYS=
NEXT_PUBLIC_SUPPORT_RETENTION_MONTHS=
NEXT_PUBLIC_MINIMUM_AGE=
# Preview only: permits a noindex website build with OWNER_REQUIRED markers.
NEXT_PUBLIC_LEGAL_PREVIEW=0
NEXT_PUBLIC_YANDEX_WEBMASTER_VERIFICATION=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Android release metadata (build/release script only).
APP_VERSION_CODE=
APP_VERSION_NAME=

# Owner/Admin Telegram User ID. OWNER_ID is the server authorization value.
# This is YOUR Telegram user ID (get it from @userinfobot)
# NEXT_PUBLIC_OWNER_ID is a legacy UI hint and is not a credential; omit it from
# production when the client does not need to display admin-only navigation.
OWNER_ID=
NEXT_PUBLIC_OWNER_ID=

# Bot username without @ — deep links for referrals (?startapp=CODE) and Wallet share
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Server aliases retained for legacy Telegram jobs.
TELEGRAM_BOT_USERNAME=
TELEGRAM_MINI_APP_URL=

# Telegram Bot Token (for Stars payments and notifications)
# Get from @BotFather. BOT_TOKEN is canonical; TELEGRAM_BOT_TOKEN is accepted as a legacy/hosting alias.
# Missing BOT_TOKEN never enables Premium grants. Optional local/test simulation
# requires both a non-production NODE_ENV and this explicit flag. Keep off in deploys.
ALLOW_TEST_PREMIUM_SIMULATION=0
BOT_TOKEN=
# TELEGRAM_BOT_TOKEN=

# Webhook secret for Telegram Bot API (required when BOT_TOKEN is set)
# Set via setWebhook secret_token. Telegram sends it in X-Telegram-Bot-Api-Secret-Token header.
# https://core.telegram.org/bots/api#setwebhook
WEBHOOK_SECRET_TOKEN=

# Secret to protect /api/telegram/setup-webhook and /api/telegram/webhook-info
# (temporary setup routes). Pass only via X-Webhook-Setup-Secret; query-string
# secrets are rejected because URLs are commonly logged and retained.
WEBHOOK_SETUP_SECRET=

# Public HTTPS base URL for Telegram webhooks; no provider-specific fallback is used.
WEBHOOK_BASE_URL=

# Signs HttpOnly web guest and future native app sessions. Required in production.
APP_SESSION_SECRET=replace-with-a-long-random-secret

# RuStore Pay SDK. Enable only for a configured RuStore subscription release;
# release validation requires the Console catalog, server keys and production mode.
NEXT_PUBLIC_RUSTORE_PAYMENTS_ENABLED=0
# Owner-only values; never put tokens in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_RUSTORE_PRODUCT_PREMIUM_MONTH=
NEXT_PUBLIC_RUSTORE_PRODUCT_PREMIUM_QUARTER=
NEXT_PUBLIC_RUSTORE_PRODUCT_PREMIUM_YEAR=
RUSTORE_CONSOLE_APP_ID=
RUSTORE_PACKAGE_NAME=
RUSTORE_ALLOWED_PRODUCT_IDS=
# Server exchanges this Console key pair for short-lived Public API JWE tokens.
RUSTORE_KEY_ID=
RUSTORE_PRIVATE_KEY_BASE64=
RUSTORE_NOTIFICATION_AES_KEY=
RUSTORE_PAY_MODE=sandbox

# Account providers. Android uses native SDK credentials and server-side
# verification. Server and build values must never use NEXT_PUBLIC_ names.
PUBLIC_APP_ORIGIN=
VK_AUTH_CLIENT_ID=
VK_AUTH_CLIENT_SECRET=
# Build-only key required by the VK ID Android SDK. It is injected into the
# APK manifest and must never be exposed through NEXT_PUBLIC_* or React code.
VK_ID_ANDROID_CLIENT_SECRET=
YANDEX_AUTH_CLIENT_ID=
YANDEX_AUTH_CLIENT_SECRET=
# Credential Manager uses the Google Web OAuth client ID as serverClientId.
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_WEB_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=

# Server-to-server email delivery adapter for registration and reset codes.
EMAIL_OTP_DELIVERY_URL=
EMAIL_OTP_DELIVERY_SECRET=
# Direct Resend delivery (preferred; replaces the webhook values above).
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Independent random HMAC secrets, each at least 32 bytes in production.
EMAIL_OTP_HASH_SECRET=
AUTH_RATE_LIMIT_SECRET=
# Set to 1 only behind an edge that overwrites X-Forwarded-For (for example,
# after confirming the production proxy contract). Otherwise socket IP is used.
AUTH_TRUST_PROXY=0

# Optional external scheduler authorization. Required when
# DISABLE_INPROCESS_CRON=1; send only as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
DISABLE_INPROCESS_CRON=0
# Production notification switch. Keep 1 until real Telegram delivery is
# intentionally enabled and verified; Android auth/API does not require it.
NOTIFICATION_DRY_RUN=1
NOTIFICATION_MIN_GAP_HOURS=3

# Development-only admin browser authentication. Production preflight rejects 1.
ADMIN_WEB_DEV_AUTH_ENABLED=0
ADMIN_WEB_DEV_SECRET=

# Diagnostic/calculation fallbacks. Production ignores approximate transits;
# keep forecast tracing off unless a bounded metadata-only incident trace is needed.
ALLOW_APPROXIMATE_TRANSITS=false
PERSONAL_FORECAST_TRACE=off

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
