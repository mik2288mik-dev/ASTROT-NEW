# Copy to android/signing.properties (it is ignored by Git), then replace every value.
# The same names can instead be supplied as environment variables or Gradle -P values.
RELEASE_STORE_FILE=C:/absolute/path/to/nebo-release.jks
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=
RELEASE_KEY_PASSWORD=
# Versions are owned by config/rustore-release.json, not this secret file.
