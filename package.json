    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "formidable": "^3.5.4",
    "framer-motion": "^12.23.24",
    "lucide-react": "^1.7.0",
    "next": "^15.5.9",
    "openai": "^6.9.1",
    "pg": "^8.11.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
