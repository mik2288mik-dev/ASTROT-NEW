  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:mobile": "cross-env MOBILE_BUILD=1 NEXT_PUBLIC_MOBILE_BUILD=1 next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "stickers:optimize": "node scripts/optimize-editorial-sticker-library.mjs && node scripts/build-newspaper-manifests.mjs",
